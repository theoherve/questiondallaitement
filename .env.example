# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...

# Brevo
BREVO_API_KEY=xkeysib-...
# Identifiant de la liste « Newsletter — Parents ». Sans lui, les inscriptions
# sont enregistrées en base mais marquées à resynchroniser (voir
# /admin/marketing/newsletter).
BREVO_LIST_ID_NEWSLETTER=
# Template Brevo de l'email de bienvenue. Variables attendues : PRENOM et
# MEMO_URL (vide tant qu'aucun mémo n'est déposé — le template doit alors
# masquer le bouton de téléchargement).
BREVO_TEMPLATE_ID_NEWSLETTER_WELCOME=

# Zoom
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_REDIRECT_URI=http://localhost:3000/api/zoom/callback

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron (Vercel Cron / external scheduler)
CRON_SECRET=your_cron_secret

# "false" = mode formations en ligne uniquement (désactive la réservation de RDV côté front).
# Absent ou toute autre valeur = réservation activée.
NEXT_PUBLIC_BOOKING_ENABLED=true
